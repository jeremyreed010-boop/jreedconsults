# J. Reed Consults LLC — Environment Variables
# NEVER commit .env to git

# Supabase — from Project Settings → API in the Supabase dashboard
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Only these emails are allowed to sign in (comma-separated)
ALLOWED_EMAILS=jeremyreed010@gmail.com

# IRS standard mileage rate (dollars per mile) for the current tax year.
# 2026 rate: $0.725 (IRS Notice 2026-10). Update each January.
IRS_MILEAGE_RATE=0.725

# Resend — for sending invoices via email.
# Get this from https://resend.com → API Keys. Scope to jreedconsults.com only.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# Address invoices are sent from (must be on a verified Resend domain)
INVOICE_FROM_EMAIL=jeremy@jreedconsults.com
INVOICE_FROM_NAME=Jeremy Reed
# Business details printed on the invoice
INVOICE_BUSINESS_NAME=J. Reed Consults LLC
INVOICE_BUSINESS_ADDRESS=
INVOICE_BUSINESS_EMAIL=jeremy@jreedconsults.com

# Server port (Railway sets this automatically in production)
PORT=3000
